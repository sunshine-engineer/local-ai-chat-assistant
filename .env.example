# File: .env.example
# Purpose: Public example runtime and deployment overrides; copy privately to .env.
# Maintainer: sunshine-engineer
# Modified: 2026-10-23
# Omitted settings fall back to config/defaults.toml or Compose defaults.

# Host model endpoint; Compose overrides its app to the internal Ollama service.
OLLAMA_HOST=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_KEEP_ALIVE=1m
OLLAMA_CONTEXT=16384
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_OUTPUT_TOKENS=4096
ASSISTANT_PROMPT_CHAR_LIMIT=24000
ASSISTANT_REQUIREMENT_BATCH_SIZE=3
GOOGLE_TIMEOUT_SECONDS=60

# Ordinary-chat sidebar defaults; ranges stay 0..1 and 50..300 respectively.
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=150
TRACKER_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# Workflow home must match the mount when using the supplied Compose app.
ASSISTANT_HOME=.assistant
DATABASE_URL=sqlite:///assistant.db
# Optional host PostgreSQL fallback: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD.
# Never place a real password in this public example.

# Public local-demo values only. Set a private password before non-demo use.
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
# POSTGRES_PASSWORD=replace-with-a-private-local-password
POSTGRES_PORT=5432
CHATBOT_PORT=8501
OLLAMA_CONTAINER_NAME=ollama
CHATBOT_CONTAINER_NAME=qa-chatbot
POSTGRES_CONTAINER_NAME=postgres

# Existing host reference folder, mounted read-only at /evidence in the app.
ASSISTANT_EVIDENCE_DIR=./examples
# External tracing stays off; enabling it may export private prompt text.
LANGSMITH_TRACING=false
