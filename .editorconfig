# File: .editorconfig
# Purpose: Consistent text encoding, line endings and indentation across editors.
# Maintainer: sunshine-engineer
# Modified: 2026-10-23
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
